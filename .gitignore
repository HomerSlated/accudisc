# Build output
build/
*.o
*.so
*.so.*
*.a

# Internal-only tree (git-ignored, never pushed). Holds third-party code
# snapshots, the licensed MMC spec, agent reports, raw research, and the
# Guardian signing keyring. MUST stay ignored — see CLAUDE.md.
private/

# Disc-capture artifacts written at the repo root (real audio data, never
# committable). Root-anchored so the same extensions stay legal as fixtures
# under tests/.
/*.pcm
/*.c2
/*.sub
/*.cdtext
/*.fulltoc
/*.bin
/*.toc
/*.wav

# Editors / tooling
.cache/
compile_commands.json
.vscode/
.idea/
backups/
scripts/

# Bindings build artifacts
bindings/rust/target/
bindings/python/dist/
bindings/python/*.egg-info/
__pycache__/
# cffi API mode generates a C file and compiles it in place; both are outputs
# of build_accudisc.py and must never be committed — a stale checked-in
# _accudisc.c would be built against a header it no longer matches.
bindings/python/accudisc/_accudisc.c
bindings/python/accudisc/*.o
bindings/python/accudisc/*.so

# Session history, agent definitions, remember system. Local tooling and
# personal config — never pushed. .claude/agents/ is backed up via
# scripts/backup.manifest instead, since git cannot restore it.
.remember/
.claude/
