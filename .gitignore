# Distribution tarballs, produced by tools/mkdist.sh. Build output, not source:
# every byte in them comes from tracked files, so the repo already holds
# everything they contain.
dist/

# Build output
build/
*.o
*.so
*.so.*
*.a

# Internal-only tree (git-ignored, never pushed). Holds third-party code
# snapshots, the licensed MMC spec, agent reports, raw research, and the
# Guardian signing keyring. MUST stay ignored — see CLAUDE.md.
private/

# Disc-capture artifacts written at the repo root (real audio data, never
# committable). Root-anchored so the same extensions stay legal as fixtures
# under tests/.
/*.pcm
/*.c2
/*.sub
/*.cdtext
/*.fulltoc
/*.bin
/*.toc
/*.wav

# Editors / tooling
.cache/
compile_commands.json
.vscode/
.idea/
backups/
scripts/

# Bindings build artifacts
bindings/rust/target/
bindings/python/dist/
bindings/python/*.egg-info/
__pycache__/
# cffi API mode generates a C file and compiles it in place; both are outputs
# of build_accudisc.py and must never be committed — a stale checked-in
# _accudisc.c would be built against a header it no longer matches.
bindings/python/accudisc/_accudisc.c
bindings/python/accudisc/*.o
bindings/python/accudisc/*.so
# `pip` here is uv-backed and drops a lockfile on install; it locks only cffi
# and is an artifact of whoever last ran it, not a project input.
bindings/python/uv.lock

# Session history, agent definitions, remember system. Local tooling and
# personal config — never pushed. .claude/agents/ is backed up via
# scripts/backup.manifest instead, since git cannot restore it.
.remember/
.claude/

# hardedit(1) backups. It writes dst.YYYYmmdd-HHMMSS.bak beside the file on
# every edit and never removes them, so docs/reference/ accumulates one per
# change to RECOVERY.md. Ignored rather than deleted: they are the documented
# recovery path for a hardedit that fails after the truncate (exit 2), and
# scripts/sync.py aborts on any untracked file, so without this every edit to
# that document would block the next commit. cdda2img already ignores *.bak
# (.gitignore:49).
*.bak
